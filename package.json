{
  "name": "ezidi-portal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Êzîdî-Wissensportal – deutschsprachiges Wissensportal über die Êzîdî (Religion, Geschichte, Kultur, Sprache, Verfolgung, Gegenwart)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:map && astro dev",
    "start": "npm run prepare:map && astro dev",
    "build": "npm run prepare:map && astro build && pagefind --site dist && node ./scripts/postbuild-report.mjs",
    "build:nosearch": "npm run prepare:map && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:content": "tsx ./scripts/check-content.ts",
    "check:links": "tsx ./scripts/link-check.ts",
    "report:content": "tsx ./scripts/build-report.ts",
    "quelle:lesen": "node ./scripts/quelle-lesen.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "verify": "npm run check:content && npm run check && npm run lint && npm run test && npm run build",
    "prepare:map": "node ./scripts/copy-map-worker.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "fontkit": "^2.0.4",
    "maplibre-gl": "^6.0.0",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.5.0",
    "pagefind": "^1.5.2",
    "pdf-parse": "^1.1.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  }
}
