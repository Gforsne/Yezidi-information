---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
  /** Eigener Hinweistext; ohne Angabe gilt der Standardtext des Genozid-Bereichs. */
  text?: string;
  locale?: Locale;
}

const { text, locale = 'de' } = Astro.props;
const t = useTranslations(locale);
const hinweis = text ?? t('cw.genocide');
---

{/*
  Dezenter, immer sichtbarer Inhaltshinweis – bewusst KEINE Verdeckung
  des Textes und kein Aufklapp-Zwang: Wer diesen Bereich aufruft, sucht
  die Information. Der Hinweis rahmt sie, statt sie zu inszenieren.
*/}
<aside class="inhaltshinweis" role="note" aria-labelledby="cw-titel">
  <p class="titel" id="cw-titel">
    <span class="zeichen" aria-hidden="true">!</span>
    {t('cw.title')}
  </p>
  <p class="text">{hinweis}</p>
</aside>

<style>
  .inhaltshinweis {
    margin-block-end: var(--s-6);
    padding: var(--s-3) var(--s-4);
    background: var(--c-warn-surface);
    border: var(--border-hair) solid var(--c-warn);
    border-radius: var(--radius-sm);
    font-family: var(--f-utility);
    font-size: var(--t-sm);
    max-inline-size: var(--measure);
  }

  .titel {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-2xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-warn);
    margin-block-end: var(--s-2);
  }

  .zeichen {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.25em;
    block-size: 1.25em;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 0.9em;
    line-height: 1;
  }

  .text {
    color: var(--c-text);
    line-height: var(--lh-snug);
  }
</style>
