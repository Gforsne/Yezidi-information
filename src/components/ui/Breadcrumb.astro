---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import type { Crumb } from '../../lib/navigation';

interface Props {
  crumbs: readonly Crumb[];
  locale: Locale;
}

const { crumbs, locale } = Astro.props;
const t = useTranslations(locale);
---

<nav class="breadcrumb" aria-label={t('nav.breadcrumb')}>
  <ol>
    {
      crumbs.map((c, i) => (
        <li>
          {c.href ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
          {i < crumbs.length - 1 && (
            <span class="trenner" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-block-end: var(--s-4);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--f-utility);
    font-size: var(--t-xs);
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  a {
    color: var(--c-text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  [aria-current='page'] {
    color: var(--c-text);
  }

  .trenner {
    color: var(--c-text-faint);
  }
</style>
