---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/*
  Lesefortschritt. Rein dekorativ-orientierend, deshalb aria-hidden und
  ohne Bewegung: Der Balken springt auf den Wert, statt zu animieren.
  Ohne JavaScript bleibt er unsichtbar.
*/}
<div class="fortschritt" data-fortschritt hidden>
  <span class="nur-screenreader">{t('nav.readingProgress')}</span>
  <div class="balken" aria-hidden="true"><span data-fortschritt-balken></span></div>
</div>

<style>
  .fortschritt {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    block-size: 3px;
    margin-block-end: var(--s-4);
  }

  .balken {
    block-size: 100%;
    background: var(--c-surface-sunken);
  }

  .balken span {
    display: block;
    block-size: 100%;
    inline-size: 0%;
    background: var(--c-accent);
    /* bewusst ohne transition – im Genozid-Bereich ist Bewegung gesperrt */
  }

  @media print {
    .fortschritt {
      display: none;
    }
  }
</style>

<script>
  const huelle = document.querySelector<HTMLElement>('[data-fortschritt]');
  const balken = document.querySelector<HTMLElement>('[data-fortschritt-balken]');
  const artikel = document.querySelector<HTMLElement>('[data-artikeltext]');

  if (huelle && balken && artikel) {
    huelle.hidden = false;
    let angefordert = false;

    const rechne = () => {
      angefordert = false;
      const start = artikel.offsetTop;
      const laenge = artikel.offsetHeight - window.innerHeight;
      if (laenge <= 0) {
        balken.style.inlineSize = '100%';
        return;
      }
      const anteil = (window.scrollY - start) / laenge;
      balken.style.inlineSize = `${Math.min(100, Math.max(0, anteil * 100)).toFixed(1)}%`;
    };

    const anfordern = () => {
      if (angefordert) return;
      angefordert = true;
      requestAnimationFrame(rechne);
    };

    window.addEventListener('scroll', anfordern, { passive: true });
    window.addEventListener('resize', anfordern, { passive: true });
    rechne();
  }
</script>
