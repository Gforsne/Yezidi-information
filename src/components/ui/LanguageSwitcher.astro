---
import { localeMeta, locales, type Locale } from '../../i18n/config';
import { path, switchLocalePath, useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
  /**
   * Sprachen, in denen es die aktuelle Seite tatsächlich gibt.
   * `null` steht für Seiten außerhalb des Sprachroutings.
   *
   * Alle vier Sprachen bleiben immer sichtbar – wer die Sprache wechseln
   * will, soll das können. Fehlt die Übersetzung, führt der Link auf die
   * Startseite der Zielsprache statt auf eine Adresse, die es nicht gibt.
   */
  sprachen?: readonly Locale[] | null | undefined;
}

const { locale, sprachen = locales } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const vorhanden = new Set<Locale>(sprachen ?? []);
---

{/*
  Bewusst ohne JavaScript: ein <details>-Element wäre ohne JS nicht
  tastaturvollständig zu schließen, eine Liste sichtbarer Links dagegen
  funktioniert immer. Die aktuelle Sprache ist mit aria-current markiert.
*/}
<nav class="sprachumschalter" aria-label={t('lang.switch')}>
  <span class="nur-screenreader">{t('lang.switch')}</span>
  <ul>
    {
      locales.map((code) => {
        const meta = localeMeta[code];
        const aktiv = code === locale;
        const uebersetzt = vorhanden.has(code);
        const ziel = uebersetzt ? switchLocalePath(pathname, code) : path(code);
        return (
          <li>
            <a
              href={ziel}
              lang={meta.bcp47}
              hreflang={meta.bcp47}
              dir={meta.dir}
              aria-current={aktiv ? 'true' : undefined}
              class:list={['sprache', { aktiv }]}
              data-status={meta.status}
              data-uebersetzt={uebersetzt ? 'ja' : 'nein'}
              title={
                !uebersetzt
                  ? `${meta.endonym} – ${t('lang.notTranslated')}`
                  : meta.status === 'vollstaendig'
                    ? meta.endonym
                    : `${meta.endonym} – ${t('lang.fallbackNotice')}`
              }
            >
              <span class="kuerzel">{code.toUpperCase()}</span>
              <span class="nur-screenreader">
                {meta.endonym}
                {!uebersetzt && ` – ${t('lang.notTranslated')}`}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .sprachumschalter ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sprache {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: var(--s-2);
    font-family: var(--f-utility);
    font-size: var(--t-2xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--ls-caps);
    color: var(--c-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .sprache:hover {
    color: var(--c-text);
    background: var(--c-surface-sunken);
  }

  .sprache.aktiv {
    color: var(--c-text);
    box-shadow: inset 0 -2px 0 0 var(--c-accent);
  }

  /* Ohne vorliegende Übersetzung: durchgestrichenes Kürzel als zweites
     Merkmal neben der Farbe. */
  .sprache[data-uebersetzt='nein'] .kuerzel {
    /* Kein Opazitätsverlust – das würde den Kontrast unter AA drücken.
       Der Durchstrich allein trägt die Information. */
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  /* Sprachen mit unvollständiger Oberfläche bekommen einen dezenten Punkt. */
  .sprache[data-status='stub'] .kuerzel::after,
  .sprache[data-status='gerüst'] .kuerzel::after {
    content: '';
    display: inline-block;
    inline-size: 0.3em;
    block-size: 0.3em;
    margin-inline-start: 0.25em;
    vertical-align: 0.4em;
    border-radius: 50%;
    background: var(--c-text-faint);
  }
</style>
