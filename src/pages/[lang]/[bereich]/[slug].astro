---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArtikelLayout from '../../../layouts/ArtikelLayout.astro';
import { mdxKomponenten } from '../../../components/mdx';
import { locales, type Locale } from '../../../i18n/config';
import { sectionById, type SectionId } from '../../../lib/sections';

type Eintrag =
  CollectionEntry<'articles'> | CollectionEntry<'festivals'> | CollectionEntry<'misconceptions'>;

export async function getStaticPaths() {
  const [artikel, feste, missverstaendnisse] = await Promise.all([
    getCollection('articles'),
    getCollection('festivals'),
    getCollection('misconceptions'),
  ]);

  const alle: { eintrag: Eintrag; section: SectionId }[] = [
    ...artikel.map((e) => ({ eintrag: e as Eintrag, section: e.data.section })),
    ...feste.map((e) => ({ eintrag: e as Eintrag, section: 'feste' as SectionId })),
    ...missverstaendnisse.map((e) => ({
      eintrag: e as Eintrag,
      section: 'missverstaendnisse' as SectionId,
    })),
  ];

  const veroeffentlicht = alle.filter(({ eintrag }) => !eintrag.data.draft);

  /*
    Eine Route wird durch Bereich und Slug bestimmt, nicht durch die
    Sprache. Zu jedem Paar kann es mehrere Fassungen geben; ausgeliefert
    wird die Fassung in der angefragten Sprache, sonst die deutsche.
    So bedient die deutsche Fassung weiterhin alle vier Sprachrouten –
    aber sobald eine Übersetzung existiert, tritt sie an ihre Stelle,
    ohne dass zwei Einträge um dieselbe Adresse streiten.
  */
  const nachRoute = new Map<string, { section: SectionId; fassungen: Map<string, Eintrag> }>();
  for (const { eintrag, section } of veroeffentlicht) {
    const schluessel = `${section}/${eintrag.data.slug}`;
    const vorhanden = nachRoute.get(schluessel) ?? { section, fassungen: new Map() };
    vorhanden.fassungen.set(eintrag.data.lang, eintrag);
    nachRoute.set(schluessel, vorhanden);
  }

  return [...nachRoute.values()].flatMap(({ section, fassungen }) => {
    const bereich = sectionById[section].slug;
    const deutsch = fassungen.get('de');
    return locales.flatMap((lang) => {
      const eintrag = fassungen.get(lang) ?? deutsch;
      // Eine Fassung ohne deutsches Original bedient nur ihre eigene Route.
      if (!eintrag) return [];
      return [
        {
          params: { lang, bereich, slug: eintrag.data.slug },
          props: { eintrag, section, hatDeutschesOriginal: Boolean(deutsch) },
        },
      ];
    });
  });
}

const locale = Astro.params.lang as Locale;
const { eintrag, section, hatDeutschesOriginal } = Astro.props as {
  eintrag: Eintrag;
  section: SectionId;
  hatDeutschesOriginal: boolean;
};
const { Content, headings, remarkPluginFrontmatter } = await render(eintrag);

const kennzahlen = remarkPluginFrontmatter as {
  _zitate?: number;
  _belegluecken?: number;
  _abschnitte?: number;
};

const daten = eintrag.data as Eintrag['data'] & {
  gliederung?: string[];
  rechercheauftrag?: string;
  weiterfuehrend?: string[];
  perspektive?: 'emisch' | 'etisch' | 'gemischt';
};

const bereichWarnung = sectionById[section].contentWarning ?? false;

/*
  Der Sprachumschalter zeigt alle Routen, die es zu dieser Adresse gibt.
  Da die deutsche Fassung jede Sprachroute bedient, solange keine
  Übersetzung vorliegt, sind das alle vier – außer bei einer Fassung,
  die kein deutsches Original hat.
*/
const sprachen = hatDeutschesOriginal ? locales : [eintrag.data.lang];
---

<ArtikelLayout
  locale={locale}
  section={section}
  slug={daten.slug}
  title={daten.title}
  lead={daten.lead}
  status={daten.status}
  confidence={daten.confidence}
  perspektive={daten.perspektive ?? 'gemischt'}
  contentWarning={daten.contentWarning || bereichWarnung}
  contentWarningText={daten.contentWarningText ?? null}
  updated={daten.updated}
  reviewedBy={daten.reviewedBy}
  openQuestions={daten.openQuestions}
  sources={daten.sources}
  tags={daten.tags}
  gliederung={daten.gliederung ?? []}
  rechercheauftrag={daten.rechercheauftrag}
  weiterfuehrend={daten.weiterfuehrend ?? []}
  headings={headings}
  zitate={kennzahlen._zitate ?? 0}
  belegluecken={kennzahlen._belegluecken ?? 0}
  abschnitte={kennzahlen._abschnitte ?? 0}
  ogImage={`/og/artikel/${sectionById[section].slug}/${daten.slug}.png`}
  sprachen={sprachen}
  inhaltssprache={eintrag.data.lang}
>
  <Content components={mdxKomponenten} />
</ArtikelLayout>
